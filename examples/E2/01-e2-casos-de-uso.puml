@startuml
left to right direction
skinparam packageStyle rectangle

rectangle "BiblioYa" as S1 {
  usecase "Buscar libro" as UC1
  usecase "Reservar libro" as UC2
  usecase "Prestar libro" as UC3
  usecase "Devolver libro" as UC4
  usecase "Identificar socio" as UC5
  usecase "Notificar disponibilidad" as UC6
}
actor "Socio" as A1
actor "Bibliotecario" as A2
actor "Servicio de correo" as A3

A1 -- UC1
A1 -- UC2
A2 -- UC3
A2 -- UC4
UC3 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>
UC2 ..> UC1 : <<include>>
UC6 ..> UC4 : <<extend>>
UC6 -- A3
@enduml