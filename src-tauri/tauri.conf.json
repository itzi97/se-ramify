{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "se-ramify",
  "version": "0.2.0",
  "identifier": "dev.seramify.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "se-ramify",
        "width": 1400,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Software Engineering diagrams, locally",
    "longDescription": "UML, system / use case, stakeholder, design thinking, story map, Kanban and Gantt diagrams for a Software Engineering course. Local JSON files, no accounts.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      },
      "rpm": {
        "release": "1",
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
